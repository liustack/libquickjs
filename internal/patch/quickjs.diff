diff --git a/quickjs.c b/quickjs.c
index ebf45a9..b69e671 100644
--- a/quickjs.c
+++ b/quickjs.c
@@ -51,7 +51,7 @@
 #if defined(EMSCRIPTEN)
 #define DIRECT_DISPATCH  0
 #else
-#define DIRECT_DISPATCH  1
+#define DIRECT_DISPATCH  0
 #endif
 
 #if defined(__APPLE__)
@@ -68,12 +68,12 @@
 /* define to include Atomics.* operations which depend on the OS
    threads */
 #if !defined(EMSCRIPTEN)
-#define CONFIG_ATOMICS
+// #define CONFIG_ATOMICS
 #endif
 
 #if !defined(EMSCRIPTEN)
 /* enable stack limitation */
-#define CONFIG_STACK_CHECK
+// #define CONFIG_STACK_CHECK
 #endif
 
 
@@ -11362,15 +11362,26 @@ static char *i64toa(char *buf_end, int64_t n, unsigned int base)
     return q;
 }
 
+int snprintf_with_rounding_mode(int rounding_mode, char *str, size_t size, int format, int width, double d);
+
+
 /* buf1 contains the printf result */
 static void js_ecvt1(double d, int n_digits, int *decpt, int *sign, char *buf,
                      int rounding_mode, char *buf1, int buf1_size)
 {
+#ifndef __CCGO__
     if (rounding_mode != FE_TONEAREST)
         fesetround(rounding_mode);
     snprintf(buf1, buf1_size, "%+.*e", n_digits - 1, d);
     if (rounding_mode != FE_TONEAREST)
         fesetround(FE_TONEAREST);
+#else
+    if (rounding_mode != FE_TONEAREST) {
+        snprintf_with_rounding_mode(rounding_mode, buf1, buf1_size, 0, n_digits - 1, d);
+    } else {
+        snprintf(buf1, buf1_size, "%+.*e", n_digits - 1, d);
+    }
+#endif
     *sign = (buf1[0] == '-');
     /* mantissa */
     buf[0] = buf1[1];
@@ -11450,11 +11461,19 @@ static int js_fcvt1(char (*buf)[JS_DTOA_BUF_SIZE], double d, int n_digits,
                     int rounding_mode)
 {
     int n;
+#ifndef __CCGO__
     if (rounding_mode != FE_TONEAREST)
         fesetround(rounding_mode);
     n = snprintf(*buf, sizeof(*buf), "%.*f", n_digits, d);
     if (rounding_mode != FE_TONEAREST)
         fesetround(FE_TONEAREST);
+#else
+    if (rounding_mode != FE_TONEAREST) {
+        n = snprintf_with_rounding_mode(rounding_mode, *buf, sizeof(*buf), 1, n_digits, d);
+    } else {
+        n = snprintf(*buf, sizeof(*buf), "%.*f", n_digits, d);
+    }
+#endif
     assert(n < sizeof(*buf));
     return n;
 }
@@ -55867,3 +55886,11 @@ void JS_AddIntrinsicTypedArrays(JSContext *ctx)
     JS_AddIntrinsicAtomics(ctx);
 #endif
 }
+
+JSValue DupValue(JSContext *ctx, JSValueConst v) {
+       return JS_DupValue(ctx, v);
+}
+
+void FreeValue(JSContext *ctx, JSValue v) {
+       JS_FreeValue(ctx, v);
+}
