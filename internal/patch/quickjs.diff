 /* buf1 contains the printf result */
 static void js_ecvt1(double d, int n_digits, int *decpt, int *sign, char *buf,
                      int rounding_mode, char *buf1, int buf1_size)
 {
+#ifndef __CCGO__
     if (rounding_mode != FE_TONEAREST)
         fesetround(rounding_mode);
     snprintf(buf1, buf1_size, "%+.*e", n_digits - 1, d);
     if (rounding_mode != FE_TONEAREST)
         fesetround(FE_TONEAREST);
+#else
+    if (rounding_mode != FE_TONEAREST) {
+        snprintf_with_rounding_mode(rounding_mode, buf1, buf1_size, 0, n_digits - 1, d);
+    } else {
+        snprintf(buf1, buf1_size, "%+.*e", n_digits - 1, d);
+    }
+#endif
     *sign = (buf1[0] == '-');
     /* mantissa */
     buf[0] = buf1[1];
@@ -11452,11 +11463,19 @@ static int js_fcvt1(char (*buf)[JS_DTOA_BUF_SIZE], double d, int n_digits,
                     int rounding_mode)
 {
     int n;
+#ifndef __CCGO__
     if (rounding_mode != FE_TONEAREST)
         fesetround(rounding_mode);
     n = snprintf(*buf, sizeof(*buf), "%.*f", n_digits, d);
     if (rounding_mode != FE_TONEAREST)
         fesetround(FE_TONEAREST);
+#else
+    if (rounding_mode != FE_TONEAREST) {
+        n = snprintf_with_rounding_mode(rounding_mode, *buf, sizeof(*buf), 1, n_digits, d);
+    } else {
+        n = snprintf(*buf, sizeof(*buf), "%.*f", n_digits, d);
+    }
+#endif
     assert(n < sizeof(*buf));
     return n;
 }
